# Credit Portfolio Analyzer — variables de entorno
# Copiar a .env y completar. Nunca commitear .env.

# API key de Groq — obtener en https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Modelo Groq para reportes narrativos
GROQ_MODEL=llama-3.3-70b-versatile

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambiar_por_clave_aleatoria

# Base de datos (relativo a backend/)
DATABASE_URL=db/portfolio.db

# CORS (separar con comas si hay varios orígenes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
